# !!! DO NOT RENAME THE PROJECT !!!
# `name: paperless` must stay exactly like this. It is the project name of the
# stack that holds the production data on the NAS. Any other value (or dropping
# the line) makes `docker compose` treat this file as a NEW project and start a
# second stack — including a second Postgres — on the very same bind-mounted
# ./db directory. That already happened once with `paperless-ngx-nas`
# (commit a16fad6 / PR #357). The same applies to the service names (`db`,
# `broker`, `paperless`) and the ./db bind mount: do not rename or move them.
name: paperless

services:
  broker:
    image: "{{ paperless_redis_image }}"
    restart: unless-stopped
    volumes: []

  db:
    image: "{{ paperless_db_image }}"
    restart: unless-stopped
    environment:
      POSTGRES_USER: "{{ paperless_db_user }}"
      # No secret in this file: Compose interpolates the value from the .env
      # next to it (mode 0640). It resolves to the same string as before, so the
      # container config is unchanged; Postgres only reads POSTGRES_PASSWORD
      # when it initialises an EMPTY data directory, never for an existing one.
      POSTGRES_PASSWORD: "${PAPERLESS_DBPASS:?PAPERLESS_DBPASS missing in .env}"
      POSTGRES_DB: "{{ paperless_db_name }}"
    volumes:
      - "./db:/var/lib/postgresql/data"

  paperless:
    image: "{{ paperless_image }}"
    restart: unless-stopped
    depends_on:
      - db
      - broker
    env_file:
      - .env
    volumes:
      - "./data:/usr/src/paperless/data"
      - "./media:/usr/src/paperless/media"
      - "./export:/usr/src/paperless/export"
      - "./consume:/usr/src/paperless/consume"
    ports:
      - "{{ paperless_http_port }}:8000"

{% if paperless_ai_enabled %}
  paperless-ai:
    image: "{{ paperless_ai_image }}"
    container_name: paperless-ai
    restart: unless-stopped
    environment:
      - PUID={{ paperless_uid }}
      - PGID={{ paperless_gid }}
      - PAPERLESS_AI_PORT=3000
      - RAG_SERVICE_URL=http://paperless:8000
      - RAG_SERVICE_ENABLED=true
    ports:
      - "{{ paperless_ai_port }}:3000"
    volumes:
      - paperless-ai_data:/app/data
{% endif %}

networks:
  default:
    name: paperless_net

{% if paperless_ai_enabled %}
volumes:
  paperless-ai_data:
{% endif %}
