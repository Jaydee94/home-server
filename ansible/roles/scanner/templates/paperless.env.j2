# ANSIBLE MANAGED — scanner role
# Sourced by scan_to_pdf.sh to upload scans via Paperless REST API.
# Mode 0640, owned by root:scanner — readable for saned via the scanner group.
PAPERLESS_API_ENABLED={{ scanner_paperless_api_enabled | ternary('1', '0') }}
PAPERLESS_URL={{ scanner_paperless_api_url }}
PAPERLESS_TOKEN={{ scanner_paperless_api_token }}
PAPERLESS_API_TIMEOUT={{ scanner_paperless_api_timeout_seconds }}
