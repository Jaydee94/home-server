---
# k3s server configuration — generated by Ansible, do not edit manually.
write-kubeconfig-mode: "0600"
tls-san:
  - "{{ k3s_server_ip }}"
  - "{{ hostname }}"
  - "127.0.0.1"
cluster-cidr: "{{ k3s_pod_cidr }}"
service-cidr: "{{ k3s_service_cidr }}"
node-name: "{{ hostname }}"
kubelet-arg:
  - "system-reserved={{ k3s_kubelet_system_reserved }}"
  - "eviction-hard={{ k3s_kubelet_eviction_hard }}"
  - "image-gc-high-threshold={{ k3s_kubelet_image_gc_high_threshold }}"
  - "image-gc-low-threshold={{ k3s_kubelet_image_gc_low_threshold }}"
